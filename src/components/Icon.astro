interface Props {
	name: keyof typeof icons;
	size?: number;
	class?: string;
	filled?: boolean;
}
const { name, size = 24, class: className, filled = false } = Astro.props;
---

<svg
	class={className}
	width={size}
	height={size}
	viewBox="0 0 24 24"
	fill={filled ? 'currentColor' : 'none'}
	stroke={filled ? 'none' : 'currentColor'}
	stroke-width="2"
	stroke-linecap="round"
	stroke-linejoin="round"
	aria-hidden="true"
	set:html={icons[name]}
/>
