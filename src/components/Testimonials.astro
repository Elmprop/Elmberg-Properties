---
import Icon from './Icon.astro';
import { testimonials } from '../data/site';
---

<section class="section reviews on-dark" id="reviews">
	<div class="container">
		<div class="section-head center">
			<p class="eyebrow" data-reveal>Testimonials</p>
			<h2 class="section-title" data-reveal>Hear what <em>landowners</em> say</h2>
			<div class="rating" data-reveal>
				<span class="stars" aria-hidden="true">
					{Array.from({ length: 5 }).map(() => <Icon name="star" size={20} filled />)}
				</span>
				<span><strong>99%</strong> customer satisfaction</span>
			</div>
		</div>

		<ul class="review-grid">
			{testimonials.map((t, i) => (
				<li class="review" data-reveal style={`--delay:${i * 90}ms`}>
					<figure>
						<span class="stars" role="img" aria-label="5 out of 5 stars">
							{Array.from({ length: 5 }).map(() => <Icon name="star" size={16} filled />)}
						</span>
						<blockquote>
							<p>“{t.quote}”</p>
						</blockquote>
						<figcaption>
							<span class="avatar" aria-hidden="true">{t.name.charAt(0)}</span>
							<span>
								<strong>{t.name}</strong>
								<small>Landowner</small>
							</span>
						</figcaption>
					</figure>
				</li>
			))}
		</ul>
	</div>
</section>

<style>
	.reviews {
		position: relative;
		isolation: isolate;
		background: var(--navy-950);
		color: var(--white);
		overflow: hidden;
	}
	.reviews::before {
		content: '';
		position: absolute;
		inset: 0;
		z-index: -1;
		background:
			radial-gradient(50% 60% at 50% 0%, rgb(121 82 23 / 0.4), transparent 70%),
			radial-gradient(40% 50% at 100% 100%, rgb(20 50 104 / 0.7), transparent 70%);
	}
	.rating {
		display: inline-flex;
		flex-wrap: wrap;
		justify-content: center;
		align-items: center;
		gap: 0.5rem 0.85rem;
		padding: 0.6rem 1.2rem;
		border-radius: 999px;
		background: rgb(255 255 255 / 0.06);
		border: 1px solid rgb(255 255 255 / 0.12);
		font-size: 0.92rem;
		color: rgb(255 255 255 / 0.85);
	}
	.rating strong {
		color: var(--gold-400);
	}
	.stars {
		display: inline-flex;
		gap: 2px;
		color: var(--gold-400);
	}

	.review-grid {
		display: grid;
		gap: 1.25rem;
		list-style: none;
		margin: 0;
		padding: 0;
	}
	.review figure {
		display: flex;
		flex-direction: column;
		height: 100%;
		margin: 0;
		padding: 1.75rem;
		border-radius: var(--radius-lg);
		background: linear-gradient(160deg, rgb(255 255 255 / 0.09), rgb(255 255 255 / 0.03));
		border: 1px solid rgb(255 255 255 / 0.1);
		transition:
			transform 0.35s ease,
			border-color 0.35s ease;
	}
	.review figure:hover {
		transform: translateY(-4px);
		border-color: rgb(201 151 63 / 0.45);
	}
	blockquote {
		flex: 1;
		margin: 1rem 0 1.5rem;
	}
	blockquote p {
		font-family: var(--font-display-stack);
		font-size: 1.3rem;
		line-height: 1.4;
	}
	figcaption {
		display: flex;
		align-items: center;
		gap: 0.85rem;
		padding-top: 1.25rem;
		border-top: 1px solid rgb(255 255 255 / 0.1);
		line-height: 1.3;
	}
	figcaption strong {
		display: block;
		font-weight: 600;
	}
	figcaption small {
		font-size: 0.8rem;
		color: rgb(255 255 255 / 0.6);
	}
	.avatar {
		display: grid;
		place-items: center;
		width: 44px;
		height: 44px;
		border-radius: 50%;
		background: linear-gradient(135deg, var(--gold-200), var(--gold-500));
		color: var(--navy-900);
		font-family: var(--font-display-stack);
		font-weight: 700;
		font-size: 1.15rem;
	}

	@media (min-width: 640px) {
		.review-grid {
			grid-template-columns: repeat(2, 1fr);
		}
	}
	@media (min-width: 1100px) {
		.review-grid {
			grid-template-columns: repeat(4, 1fr);
		}
	}
</style>
